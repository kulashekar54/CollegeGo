<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CollegeGo"
    xmlns:viewmodel="clr-namespace:CollegeGo.ViewModel"
    x:DataType="viewmodel:MessageViewModel"
    x:Class="CollegeGo.MainPage">

    <Grid>
        <CollectionView 
            ItemsSource="{Binding SkeletonItems}"
            IsVisible="{Binding IsLoading}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                <Grid Padding="15" ColumnDefinitions="Auto,*,Auto" >

                    <!-- Avatar -->
                    <BoxView 
                        HeightRequest="45"
                        WidthRequest="45"
                        CornerRadius="10"
                        Background="Transparent"
                        Color="#E0E0E0"/>

                    <VerticalStackLayout Grid.Column="1" Spacing="6" Margin="15,0" HorizontalOptions="Start">

                        <BoxView HeightRequest="14" WidthRequest="180" CornerRadius="4" Background="Transparent" Color="#E0E0E0"/>
                        <BoxView HeightRequest="12" WidthRequest="180" CornerRadius="4" Background="Transparent" Color="#E0E0E0"/>
                        <BoxView HeightRequest="12" WidthRequest="180" CornerRadius="4" Background="Transparent" Color="#E0E0E0"/>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">

                        <BoxView HeightRequest="12" WidthRequest="70" CornerRadius="4" Background="Transparent" Color="#E0E0E0"/>
                        <BoxView HeightRequest="10" WidthRequest="70" CornerRadius="4" Background="Transparent" Color="#E0E0E0"/>

                    </VerticalStackLayout>

                </Grid>
            </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 🔹 Actual List -->
        <CollectionView
            ItemsSource="{Binding Items}"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
            IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MessageItem">

                <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">

                    <!-- Avatar -->
                    <Frame 
                        HeightRequest="45"
                        WidthRequest="45"
                        CornerRadius="22.5"
                        BackgroundColor="#2196F3"
                        Padding="0"
                        VerticalOptions="Center">

                        <Label 
                            Text="{Binding Name[0]}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="White"
                            FontAttributes="Bold"/>
                    </Frame>

                    <!-- Left -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0">

                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding Gmail}" FontSize="13" TextColor="Gray"/>
                        <Label Text="{Binding MobileNumber}" FontSize="13" TextColor="Gray"/>

                    </VerticalStackLayout>

                    <!-- Right -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">

                        <Label Text="{Binding Duration}" FontSize="14"/>
                        <Label Text="{Binding Time}" FontSize="12" TextColor="Gray"/>

                    </VerticalStackLayout>

                </Grid>

            </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>